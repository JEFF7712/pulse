# Pulse connector configuration.
# Copy to pulse.toml and adjust to your setup.
# Secrets (API keys, tokens) go in .env, not here.
# All connectors default to enabled = false — set true only for sources you want.

[connectors.gmail]
enabled = false
poll_interval = "15m"

[connectors.calendar]
enabled = false
poll_interval = "30m"

[connectors.youtube]
enabled = false
poll_interval = "1h"

[connectors.spotify]
enabled = false
poll_interval = "30m"
supplementary_interval = "6h"

[connectors.microsoft_mail]
enabled = false
poll_interval = "15m"

[connectors.microsoft_calendar]
enabled = false
poll_interval = "30m"
calendar_id = "primary"

[connectors.github]
enabled = false
poll_interval = "30m"

[connectors.linear]
enabled = false
poll_interval = "30m"

[connectors.gitlab]
enabled = false
poll_interval = "30m"
gitlab_base_url = "https://gitlab.com"

[connectors.plaid]
enabled = false
poll_interval = "6h"
omit_amounts_in_digest = false

[connectors.browser]
enabled = false
poll_interval = "15m"
browser = "chrome"  # or "firefox"

[connectors.feeds]
enabled = false
poll_interval = "1h"
# List RSS or Atom feed URLs (no API keys). Example:
# urls = ["https://hnrss.org/newest"]
urls = []

[connectors.notion]
enabled = false
poll_interval = "45m"
# Optional: query specific databases (UUIDs) in addition to workspace search.
# database_ids = ["aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"]

[connectors.oura]
enabled = false
poll_interval = "6h"

[connectors.companion]
enabled = false
# The companion app pushes location and health events to /webhooks/companion.
# Set PULSE_COMPANION_TOKEN in .env to enable API auth.

# --- LLM Configuration ---
# Configure providers for summarization (digest narratives),
# discovery (cross-source pattern detection), and corrections
# (interpreting Telegram / MCP feedback into bounded vault updates)
# independently.
#
# Supported providers: anthropic, openai, gemini, ollama
# API keys are read from environment variables:
#   ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY
#
# Summarization and discovery can reuse each other when only one of those
# two roles is configured. Corrections follow the separate fallback below.
#
# Option A — one provider, pick models per role (API key in .env for that vendor).
# Model ids: see Anthropic / OpenAI / Gemini docs (linked from docs/reference/configuration.md).
# [llm]
# provider = "anthropic"
#
# [llm.summarization]
# model = "claude-haiku-4-5-20251001"
#
# [llm.discovery]
# model = "claude-opus-4-6"
#
# Option B — mixed vendors (each block sets provider + model):
# [llm.summarization]
# provider = "ollama"
# model = "llama3.3"
# base_url = "http://localhost:11434/v1"
#
# [llm.discovery]
# provider = "anthropic"
# model = "claude-sonnet-4-6"
#
# [llm.corrections]
# provider = "openai"
# model = "gpt-5.4-mini"
# If omitted, corrections reuse [llm.discovery]. If neither block is set,
# corrections fall back to legacy PULSE_ANTHROPIC_API_KEY (fixed Sonnet id).

# --- Legacy (still works) ---
# If you just want Anthropic for everything, set PULSE_ANTHROPIC_API_KEY
# in .env and skip the [llm] section entirely (built-in Haiku/Sonnet defaults).
