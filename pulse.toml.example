# Pulse configuration — run `pulse configure` for interactive setup.
# See docs/reference/configuration.md for all options.

timezone = "America/Chicago"

google_client_id = ""
google_client_secret = ""
anthropic_api_key = ""

[connectors.gmail]
enabled = true
poll_interval = "15m"

[connectors.calendar]
enabled = true
poll_interval = "30m"

[connectors.feeds]
enabled = true
poll_interval = "1h"
urls = ["https://hnrss.org/newest"]

# LLM roles — provider defaults to "anthropic" when anthropic_api_key is set.
# If omitted, corrections reuse [llm.discovery].
# [llm]
# provider = "anthropic"
#
# [llm.summarization]
# model = "claude-haiku-4-5-20251001"
#
# [llm.discovery]
# model = "claude-sonnet-4-6"
#
# [llm.corrections]
# model = "claude-sonnet-4-6"
