# Pulse configuration — run `pulse configure` for interactive setup.
# See docs/reference/configuration.md for all options.
#
# Pulse is MCP-first: it ingests your data and exposes it to your own agent
# (Claude Code, Cursor, etc.) over the `pulse-mcp` server. Pulse does not call
# an LLM itself, so no LLM API key is needed here.

timezone = "America/Chicago"

# Send one alert per failing scheduler job (aggregation, connector pulls) at most
# every `job_failure_alert_cooldown` per job — requires Telegram, ntfy, Pushover, etc.
# notify_on_job_failure = false
# job_failure_alert_cooldown = "6h"

# OAuth credentials for the Google connectors (gmail, calendar).
google_client_id = ""
google_client_secret = ""
# OAuth credentials for the GitHub connector.
github_client_id = ""
github_client_secret = ""

# --- Core spine (enabled by default) ---

[connectors.gmail]
enabled = true
poll_interval = "15m"

[connectors.calendar]
enabled = true
poll_interval = "30m"

[connectors.github]
enabled = true
poll_interval = "30m"

[connectors.browser]
enabled = true
poll_interval = "15m"
browser = "firefox"   # or "chrome"

# --- Optional sources (off by default; enable the ones you use) ---

[connectors.youtube]
enabled = false
poll_interval = "1h"

[connectors.spotify]
enabled = false
poll_interval = "30m"
supplementary_interval = "6h"

[connectors.plaid]
enabled = false
poll_interval = "6h"
omit_amounts_in_digest = false

# Health/sleep. Ready for when you add a wearable.
[connectors.oura]
enabled = false
poll_interval = "6h"
