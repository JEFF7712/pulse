# Pulse configuration — run `pulse configure` for interactive setup.
# See docs/reference/configuration.md for all options.

timezone = "America/Chicago"

# When true, send one alert per failing scheduler job (discovery, aggregation, connector pulls)
# at most every `job_failure_alert_cooldown` per job — requires Telegram, ntfy, Pushover, etc.
# notify_on_job_failure = false
# job_failure_alert_cooldown = "6h"
# notify_on_corrections_backlog = false
# corrections_backlog_alert_cooldown = "12h"

google_client_id = ""
google_client_secret = ""
anthropic_api_key = ""

[connectors.gmail]
enabled = true
poll_interval = "15m"

[connectors.calendar]
enabled = true
poll_interval = "30m"

# LLM roles — provider defaults to "anthropic" when anthropic_api_key is set.
# If omitted, corrections reuse [llm.discovery].
# [llm]
# provider = "anthropic"
#
# [llm.summarization]
# model = "claude-haiku-4-5-20251001"
#
# [llm.discovery]
# model = "claude-sonnet-4-6"
#
# [llm.corrections]
# model = "claude-sonnet-4-6"
